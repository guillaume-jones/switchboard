{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Switchboard",
  "identifier": "dev.switchboard.app",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Switchboard", "width": 1200, "height": 800 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "externalBin": ["binaries/swb", "binaries/swb-hold"],
    "macOS": { "signingIdentity": "-" },
    "linux": {
      "deb": { "depends": ["git", "zsh", "dash", "jq"] },
      "rpm": { "depends": ["git", "zsh", "dash", "jq"] }
    }
  }
}
