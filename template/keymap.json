[
  { "key": "cmd-shift-p", "command": "palette.open" },
  { "key": "cmd-shift-k", "command": "keymap.context" },
  { "key": "cmd-alt-r", "command": "ui.restart" },
  { "key": "alt-j", "command": "card.focus_next" },
  { "key": "alt-k", "command": "card.focus_prev" },
  { "key": "ctrl-tab", "context": "card:Boards", "write": "ui.next_board", "args": { "client": "{client}" } },
  { "key": "cmd-[", "context": "card:Boards", "write": "ui.back", "args": { "client": "{client}" } },
  { "key": "cmd-]", "context": "card:Boards", "write": "ui.forward", "args": { "client": "{client}" } },
  { "key": "mouse-back", "context": "card:Boards", "write": "ui.back", "args": { "client": "{client}" } },
  { "key": "mouse-forward", "context": "card:Boards", "write": "ui.forward", "args": { "client": "{client}" } },
  {
    "key": "cmd-n",
    "context": "card:Boards",
    "write": "ui.open_chat",
    "args": { "client": "{client}", "session": "" }
  },
  { "key": "cmd-w", "context": "card:Boards", "write": "ui.close_board", "args": { "id": "{board}" } },
  {
    "key": "ctrl-c",
    "context": "card:Transcript && stoppable",
    "command": "sessions.stop",
    "args": { "session": "{stoppable}" }
  },
  { "key": "ctrl-shift-tab", "context": "card:Boards", "write": "ui.prev_board", "args": { "client": "{client}" } }
]
