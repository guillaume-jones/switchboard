#!/bin/zsh
# sessions.edit {prompt, session?}: sessions.headless on this folder, then commits its changes with the prompt as the message.
finish() {
  local s=${2//\\/\\\\}; s=${s//\"/\\\"}; s=${s//[[:cntrl:]]/ }
  print -r -- "{\"outcome\": \"$1\", \"summary\": \"$s\"}"
  [[ $1 == success ]]; exit
}
[[ -n $SWB_ARG_PROMPT ]] || finish failure "prompt is required"
tools=('Bash(swb check)' 'Bash(swb query:*)' 'Bash(sqlite3:*)' 'Bash(git status:*)' 'Bash(git diff:*)' 'Bash(git log:*)')
outcome=$(HEADLESS_MODE=acceptEdits HEADLESS_ALLOWED_TOOLS=${(F)tools} SWB_ARG_CWD=$SWITCHBOARD_HOME \
  "$SOURCE_DIR/commands/headless" | tee /dev/stderr | tail -1)
print -r -- $outcome | jq -e '.outcome == "success"' >/dev/null || finish failure "$(print -r -- $outcome | jq -r .summary)"
cd $SWITCHBOARD_HOME
git add -A
git diff --cached --quiet && finish success "no changes"
if ! out=$(git commit -q -m $SWB_ARG_PROMPT 2>&1); then
  git reset -q
  finish failure "not committed, changes left in the folder: $out"
fi
finish success "committed $(git rev-parse --short HEAD)"
