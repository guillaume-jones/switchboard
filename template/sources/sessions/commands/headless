#!/bin/zsh
# sessions.headless {prompt, cwd?, session?}: runs Claude Code headless (-p) in cwd (default ~) as a session owned by
# Switchboard. With session, first stops that session's running turn, if any, then resumes it with the prompt.
# HEADLESS_MODE and HEADLESS_ALLOWED_TOOLS (one per line), set by sessions.edit rather than passed as args, replace
# the auto permission mode and pre-approve tools.
prompt=$SWB_ARG_PROMPT session=$SWB_ARG_SESSION
cwd=${SWB_ARG_CWD:-$HOME}
finish() {
  local s=${2//\\/\\\\}; s=${s//\"/\\\"}; s=${s//[[:cntrl:]]/ }
  print -r -- "{\"outcome\": \"$1\", \"summary\": \"$s\"}"
  [[ $1 == success ]]; exit
}
[[ -n $prompt ]] || finish failure "prompt is required"
cd $cwd 2>/dev/null || finish failure "no folder $cwd"
if [[ -n $session ]]; then
  previous=$("$SWB" query sessions_items id=$session | jq -r '.[0] | select(.run_state == "running" or .run_state == "queued") | .run_id // empty')
  if [[ -n $previous && $previous != $RUN_ID ]]; then
    pid=$("$SWB" query core_runs id=$previous | jq -r '.[0].pid // empty')
    if [[ -n $pid ]]; then
      kill -INT -- -$pid 2>/dev/null
      while kill -0 $pid 2>/dev/null; do sleep 0.1; done
    fi
  fi
  target=(--resume $session)
else
  session=$(uuidgen | tr A-Z a-z)
  target=(--session-id $session)
fi
export SWB_SESSION_HOST=switchboard
printf %s $prompt | claude -p $target --settings $SOURCE_DIR/files/claude-hooks.json --permission-mode ${HEADLESS_MODE:-auto} \
  ${HEADLESS_ALLOWED_TOOLS:+--allowedTools} ${(f)HEADLESS_ALLOWED_TOOLS} \
  || finish failure "claude exited with $? (session $session)"
finish success "session $session"
