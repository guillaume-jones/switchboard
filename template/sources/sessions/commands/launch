#!/bin/zsh
# sessions.launch {prompt?, cwd?, session?, attach?}: opens an interactive Claude Code session in the terminal named in
# settings.json, resuming session if given, or attaching to the background session with short id attach. The run succeeds once the terminal opens; the session is tracked by hooks.
cwd=${SWB_ARG_CWD:-$HOME}
[[ -n $SWB_ARG_SESSION ]] && model=$("$SWB" query sessions_items id=$SWB_ARG_SESSION | jq -r '.[0].model // empty')
terminal=$(jq -er .terminal "$SWITCHBOARD_HOME/settings.json" 2>/dev/null) || terminal=Terminal
script=$SWITCHBOARD_HOME/data/launch/$RUN_ID.command
mkdir -p ${script:h}
cat > $script <<SCRIPT
#!/bin/zsh
cd ${(q)cwd} || exit 1
export RUN_ID=${(q)RUN_ID} SWITCHBOARD_HOME=${(q)SWITCHBOARD_HOME} SWB=${(q)SWB} PATH=${(q)PATH}
${SWB_ARG_ATTACH:+exec claude attach ${(q)SWB_ARG_ATTACH}}
exec claude --settings ${(q)SOURCE_DIR}/files/claude-hooks.json ${SWB_ARG_SESSION:+--resume ${(q)SWB_ARG_SESSION}} ${model:+--model ${(q)model}} ${SWB_ARG_PROMPT:+${(q)SWB_ARG_PROMPT}}
SCRIPT
chmod +x $script
if [[ $OSTYPE == darwin* ]]; then
  open -a $terminal $script || exit 1
else
  if [[ $terminal == Terminal ]]; then
    for terminal in x-terminal-emulator gnome-terminal konsole xterm; do (( $+commands[$terminal] )) && break; done
  fi
  (( $+commands[$terminal] )) || { print -r -- "{\"outcome\": \"failure\", \"summary\": \"no terminal $terminal\"}"; exit 1 }
  setsid -f $terminal -e $script >/dev/null 2>&1
fi
print -r -- "{\"outcome\": \"success\", \"summary\": \"launched in $terminal\"}"
