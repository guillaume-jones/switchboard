#!/bin/zsh
# sessions.preview {path}: stages a local image, keyed by the path as given, for cards to read through sessions.attachments.
path_=${SWB_ARG_PATH/#\~/$HOME}
path_=${path_:A}
[[ -f $path_ && ${path_:e:l} == (png|jpg|jpeg|gif|webp) ]] || { print -u2 "not an image: $SWB_ARG_PATH"; exit 1 }
base64 -i $path_ | tr -d '\n' | jq -Rs --arg id $SWB_ARG_PATH --arg name ${path_:t} '{id: $id, name: $name, data: .}' |
  "$SWB" write sessions.preview_add >/dev/null
