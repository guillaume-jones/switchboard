#!/bin/zsh
# sessions.send {session, text, attachments?, interject?}: sends text to a Claude session as your next prompt. Each
# attachment's {{attachment:<id>}} in the text becomes its saved path, or an "Attached file:" line is appended.
# A session Switchboard holds (sessions.serve) gets it at once, folded into the turn in progress if Claude is working;
# one another app still runs (a terminal, Zed) gets it through sessions.poke. Any other session is resumed under
# sessions.serve with it, in its folder (sessions.move), after stopping its old background process if it has one.
finish() {
  local s=${2//\\/\\\\}; s=${s//\"/\\\"}; s=${s//[[:cntrl:]]/ }
  print -r -- "{\"outcome\": \"$1\", \"summary\": \"$s\"}"
  [[ $1 == success ]]; exit
}
session=$SWB_ARG_SESSION text=$SWB_ARG_TEXT
if [[ -n $SWB_ARG_ATTACHMENTS ]]; then
  text=$("$SOURCE_DIR/files/attach" $SWB_ARG_ATTACHMENTS $text 2>&1) || finish failure "$text"
fi
[[ -n $text ]] || finish failure "text is required"
# Local commands (/usage, /context...) run without a turn, so no hook reports them done.
sent=sent
[[ ${text%% *} == /(usage|cost|context|status|stats|compact|doctor|help|release-notes|mcp) ]] && sent="ran ${text%% *}"
cwd=$("$SWB" query sessions_items id=$session | jq -r '.[0].cwd // empty')
IFS=$'\t' read -r run served_cwd <<<"$("$SWB" query sessions_served session=$session | jq -r '.[0] // empty | [.run_id, .cwd // ""] | @tsv')"
if [[ -n $run && ( -z $cwd || $served_cwd == $cwd ) ]]; then
  out=$("$SWB" run input $run "$(jq -nc --arg t $text '{text: $t}')" 2>&1) && finish success $sent
fi
IFS=$'\t' read -r pid socket live <<<"$(jq -r --arg s $session 'select(.sessionId == $s) | [.pid // "", .messagingSocketPath // "", .kind // ""] | map(tostring) | @tsv' ~/.claude/sessions/*.json 2>/dev/null | head -1)"
if [[ -n $pid && -z $run ]] && kill -0 $pid 2>/dev/null; then
  [[ $live != bg ]] && SWB_ARG_TEXT=$text SWB_ARG_ATTACHMENTS= exec "$SOURCE_DIR/commands/poke"
  claude stop ${session[1,8]} >/dev/null 2>&1
  for i in {1..500}; do kill -0 $pid 2>/dev/null || break; sleep 0.02; done
fi
if [[ -n $run ]]; then
  "$SWB" run stop $run >/dev/null 2>&1
  for i in {1..500}; do [[ -e $SWITCHBOARD_HOME/data/runs/$run/exit ]] && break; sleep 0.02; done
fi
cwd=${cwd:-$HOME}
[[ -d $cwd ]] || finish failure "no folder $cwd"
out=$("$SWB" run start sessions.serve session=$session prompt="$(print -r -- $text | jq -Rsc 'rtrimstr("\n")')" \
  cwd="$(print -r -- $cwd | jq -Rr @json)" 2>&1) || finish failure "$out"
finish success ${${sent:#sent}:-resumed}
