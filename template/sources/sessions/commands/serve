#!/usr/bin/env -S python3 -I
"""sessions.serve {session?, prompt?, cwd, model?, disallowed?, permission_mode?}: holds a Claude Code session open for Switchboard, as
`claude -p` reading stream-json, so each `swb run input $RUN_ID <line>` reaches it at once. Lines are JSON:
{"text": "..."} sends a message, folded into the turn in progress if Claude is working; {"interrupt": true} stops
the turn. Resumes session, or starts a new one with prompt, and prints {"session": "<id>"} once Claude reports it.
Exits once Claude has been idle for IDLE seconds; messages arriving meanwhile are sent to a resumed process.
Reports the session to sessions.claude_hook as its hooks would, which stop for held sessions (files/hook): only the
events that change its status, in order, from Claude's output, where a message shows up once Claude takes it.
Claude asks it for permissions (--permission-prompt-tool stdio), which it records as a pending decision and answers
once sessions.answer writes the answer given with sessions.decide into the FIFO data/decisions/<session>."""
import atexit, json, os, queue, select, signal, subprocess, sys, threading, time, uuid

IDLE = 900
ASKS = ("AskUserQuestion", "ExitPlanMode")
SLOW_TOOL = 2.0
HOOKS = os.path.join(os.environ["SOURCE_DIR"], "files", "claude-hooks.json")


class Lines:
    """Complete lines from a descriptor, read without buffering past them, so select keeps telling the truth."""

    def __init__(self, fd):
        self.fd, self.buf, self.eof = fd, b"", False

    def fill(self):
        chunk = os.read(self.fd, 65536)
        self.eof = not chunk
        self.buf += chunk

    def read(self):
        self.fill()
        *lines, self.buf = self.buf.split(b"\n")
        return [l.decode(errors="replace") for l in lines if l.strip()]

    def line(self):
        while b"\n" not in self.buf and not self.eof:
            self.fill()
        line, _, self.buf = self.buf.partition(b"\n")
        return line.decode(errors="replace")


def parse(line):
    try:
        message = json.loads(line)
    except ValueError:
        message = None
    return message if isinstance(message, dict) else {"text": line}


stdin = Lines(0)
args = json.loads(stdin.line() or "{}")
session, cwd = args.get("session") or None, os.path.expanduser(args.get("cwd") or os.environ["SWITCHBOARD_HOME"])
*early, stdin.buf = stdin.buf.split(b"\n")
queued = [{"text": args["prompt"]}] if args.get("prompt") else []
queued += [parse(l.decode(errors="replace")) for l in early if l.strip()]
finish = lambda outcome, summary: (print(json.dumps({"outcome": outcome, "summary": summary}), flush=True),
                                   sys.exit(outcome != "success"))
if not session and not queued:
    finish("failure", "session or prompt is required")

reports = queue.Queue()


def report_all():
    while True:
        payload = reports.get()
        subprocess.run([os.environ["SWB"], "write", "sessions.claude_hook", "host=switchboard", "entrypoint=sdk-cli"],
                       input=json.dumps(payload), text=True, capture_output=True)
        reports.task_done()


threading.Thread(target=report_all, daemon=True).start()
report = lambda event, **fields: reports.put({"session_id": session, "cwd": cwd, "hook_event_name": event, **fields})


def observe(event):
    """Turns one line of Claude's output into the hook event it stands for, if any."""
    global session, tool_at, asking
    kind, content = event.get("type"), (event.get("message") or {}).get("content")
    blocks = content if isinstance(content, list) else []
    if kind == "system" and event.get("subtype") == "init" and event.get("session_id") != session:
        session = event["session_id"]
        print(json.dumps({"session": session}), flush=True)
        report("SessionStart", source="startup")
    elif kind == "user" and event.get("isReplay"):
        text = content if isinstance(content, str) else "\n\n".join(b.get("text", "") for b in blocks if b.get("type") == "text")
        report("UserPromptSubmit", prompt=text)
    elif kind == "assistant":
        for block in blocks:
            if block.get("type") == "tool_use":
                tool_at = time.monotonic()
                if block.get("name") in ASKS:
                    asking = True
                    report("PreToolUse", tool_name=block["name"])
    elif kind == "user" and any(b.get("type") == "tool_result" for b in blocks):
        # A slow result may follow a permission prompt (needs_permission, from files/decide); a quick one changes nothing.
        if asking or time.monotonic() - tool_at > SLOW_TOOL:
            report("PostToolUse")
        asking = False
    elif kind == "result":
        failed = event.get("subtype") not in ("success", "error_during_execution")
        report("StopFailure" if failed else "Stop", last_assistant_message=event.get("result") or None)


tool_at, asking, decisions = time.monotonic(), False, None
decisions_path = lambda: os.path.join(os.environ["SWITCHBOARD_HOME"], "data", "decisions", session)
signal.signal(signal.SIGTERM, lambda *_: sys.exit(143))
atexit.register(lambda: decisions and os.path.exists(decisions_path()) and os.remove(decisions_path()))

while True:
    command = ["claude", "-p", "--input-format", "stream-json", "--output-format", "stream-json", "--verbose",
               "--replay-user-messages", "--permission-mode", args.get("permission_mode") or "auto", "--permission-prompt-tool", "stdio",
               "--settings", HOOKS]
    command += ["--resume", session] if session else []
    command += ["--model", args["model"]] if args.get("model") else []
    command += ["--disallowedTools", *args["disallowed"].split()] if args.get("disallowed") else []
    try:
        # SWB_HELD_PID is Claude's own pid once sh execs it, so files/hook skips this process's hooks but not those of
        # sessions it starts, which neither inherit this run as theirs.
        env = {k: v for k, v in os.environ.items() if k not in ("RUN_ID", "SWB_SESSION_HOST")}
        claude = subprocess.Popen(["/bin/sh", "-c", 'SWB_HELD_PID=$$ exec "$@"', "sh", *command], cwd=cwd,
                                  stdin=subprocess.PIPE, stdout=subprocess.PIPE, env=env)
    except OSError as e:
        finish("failure", f"cannot start claude in {cwd}: {e}")
    out = Lines(claude.stdout.fileno())
    send = lambda message: (claude.stdin.write((json.dumps(message) + "\n").encode()), claude.stdin.flush())
    busy, idle_since, closing, pending = False, time.monotonic(), False, []
    asks = {}  # request id → can_use_tool request, oldest first; the newest is the one shown

    def ask(request_id, request):
        global decisions
        if decisions is None:
            path = decisions_path()
            os.makedirs(os.path.dirname(path), exist_ok=True)
            if os.path.exists(path):
                os.remove(path)
            os.mkfifo(path)
            decisions = Lines(os.open(path, os.O_RDWR))
        asks[request_id] = request
        report("PermissionRequest", tool_name=request.get("tool_name"), tool_input=request.get("input"))

    def answer(line):
        try:
            decision = json.loads(line)["hookSpecificOutput"]["decision"]
        except (ValueError, KeyError, TypeError):
            return
        if not asks:
            return
        request_id, request = asks.popitem()
        if decision.get("behavior") == "allow":
            reply = {"behavior": "allow", "updatedInput": decision.get("updatedInput") or request.get("input") or {}}
        else:
            reply = {"behavior": "deny", "message": decision.get("message") or "Denied from Switchboard"}
        send({"type": "control_response", "response": {"subtype": "success", "request_id": request_id, "response": reply}})
        if asks:
            ask(*asks.popitem())

    def handle(message):
        global busy
        if closing:
            pending.append(message)
        elif message.get("interrupt"):
            send({"type": "control_request", "request_id": str(uuid.uuid4()), "request": {"subtype": "interrupt"}})
        elif message.get("text"):
            send({"type": "user", "message": {"role": "user", "content": message["text"]}})
            busy = True

    for message in queued:
        handle(message)
    while not out.eof:
        wait = None if busy or closing else max(0.0, idle_since + IDLE - time.monotonic())
        readable, _, _ = select.select([0, out.fd] + ([decisions.fd] if decisions else []), [], [], wait)
        if not readable:
            claude.stdin.close()
            closing = True
        if 0 in readable:
            for line in stdin.read():
                message = parse(line)
                try:
                    handle(message)
                except BrokenPipeError:
                    pending.append(message)
        if decisions and decisions.fd in readable:
            for line in decisions.read():
                answer(line)
        if out.fd in readable:
            for line in out.read():
                try:
                    event = json.loads(line)
                except ValueError:
                    continue
                if event.get("type") == "control_request" and (event.get("request") or {}).get("subtype") == "can_use_tool":
                    ask(event["request_id"], event["request"])
                elif event.get("type") == "control_cancel_request":
                    asks.pop(event.get("request_id"), None)
                observe(event)
                if event.get("type") == "result":
                    busy, idle_since = False, time.monotonic()
    code = claude.wait()
    reports.join()
    if decisions:
        os.close(decisions.fd)
        os.remove(decisions_path())
        decisions = None
    if pending and session:
        queued = pending
        continue
    if code:
        finish("failure", f"claude exited with {code}")
    finish("success", f"idle for {IDLE // 60} min" if closing else "claude exited")
