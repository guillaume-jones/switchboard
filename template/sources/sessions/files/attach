#!/bin/zsh
# files/attach <comma-separated ids> <text>: saves the attachments staged by sessions.attach to data/attachments/<id>/<name>,
# removes them from the database and prints the text with each {{attachment:<id>}} replaced by that file's path, or with
# an "Attached file: <path>" line appended for an attachment the text does not mention.
dir=$SWITCHBOARD_HOME/data/attachments
ids=(${(s:,:)1}) text=$2
rows=$("$SWB" query sessions.attachments ids=$(jq -cn '$ARGS.positional' --args $ids)) || exit 1
for id in $ids; do
  [[ $id =~ '^[A-Za-z0-9-]+$' ]] || { print -u2 "bad attachment id $id"; exit 1 }
  if [[ -z $(print -l $dir/$id/*(N)) ]]; then
    name=$(print -r -- $rows | jq -r --arg id $id '.[] | select(.id == $id) | .name')
    [[ -n $name ]] || { print -u2 "attachment $id was not uploaded"; exit 1 }
    name=${${name:t}//[^A-Za-z0-9._-]/_}
    mkdir -p $dir/$id
    print -r -- $rows | jq -r --arg id $id '.[] | select(.id == $id) | .data' | base64 -d > $dir/$id/${name:-file} || exit 1
    "$SWB" write sessions.detach id=$id >/dev/null || exit 1
  fi
  file=$(print -l -- $dir/$id/*(N) | head -1)
  if [[ $text == *"{{attachment:$id}}"* ]]; then text=${text//"{{attachment:$id}}"/$file}
  else text=${text:+$text$'\n\n'}"Attached file: $file"; fi
done
print -r -- $text
