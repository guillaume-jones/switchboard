#!/bin/zsh
# PermissionRequest hook: records the request, then waits for an answer from Switchboard (sessions.decide).
# Exits without a decision, leaving it to the session's own prompt, once the request is answered elsewhere or
# superseded, Claude Code's process is gone, or Switchboard cannot be reached.
path+=(/usr/local/bin)
swb=${SWB:-swb}
payload=$(cat)
print -r -- $payload | /bin/dash "${0:h}/hook" || exit 0
session=$(print -r -- $payload | jq -r .session_id)
mine=$("$swb" query sessions_items id=$session | jq -r '.[0].decision | fromjson? | .at // empty') || exit 0
[[ -n $mine ]] || exit 0
zmodload zsh/zselect
while :; do
  zselect -t 100
  [[ -z $CLAUDE_PID ]] || kill -0 $CLAUDE_PID 2>/dev/null || exit 0
  out=$("$swb" query sessions_items id=$session | jq -c --arg mine $mine '.[0]
    | (.decision | fromjson? // {}) as $decision | (.answer | fromjson? // null) as $answer
    | if ($decision.at // "" | tostring) != $mine then "superseded"
      elif $answer == null then empty
      else {hookSpecificOutput: {hookEventName: "PermissionRequest",
        decision: (if $answer.behavior == "allow" then {updatedInput: $decision.tool_input} + $answer else $answer end)}}
      end') || exit 0
  [[ -n $out ]] || continue
  [[ $out == '"superseded"' ]] || print -r -- $out
  exit 0
done
