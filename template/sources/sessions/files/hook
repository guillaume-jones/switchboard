#!/bin/dash
# Records a Claude Code hook event (JSON on stdin) in sessions.items, with the host app and entrypoint it ran under.
# dash, not zsh: it starts in half the time, and this runs on every tool call.
PATH=$PATH:$HOME/.local/bin:/usr/local/bin
exec "${SWB:-swb}" write sessions.claude_hook host="${SWB_SESSION_HOST:-$__CFBundleIdentifier}" entrypoint="$CLAUDE_CODE_ENTRYPOINT"
