#!/bin/dash
# Records a Claude Code hook event (JSON on stdin) in sessions.items, with the host app (bundle id, else $TERM_PROGRAM) and entrypoint it ran under.
# Sessions Switchboard holds report through sessions.serve instead, so their hooks stop here, except for files/decide.
# dash, not zsh: it starts in half the time, and this runs on every tool call.
[ "$SWB_SESSION_HOST" = switchboard ] && [ -z "$SWB_HOOK_ALWAYS" ] && exit 0
PATH=$PATH:/usr/local/bin:/Applications/Switchboard.app/Contents/MacOS
exec "${SWB:-swb}" write sessions.claude_hook host="${SWB_SESSION_HOST:-${__CFBundleIdentifier:-$TERM_PROGRAM}}" entrypoint="$CLAUDE_CODE_ENTRYPOINT"
