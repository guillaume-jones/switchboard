#!/bin/zsh
# term.open {name, cwd, chat, command}: creates the tmux session `name` in `cwd` (else ~), unless it exists, and links it to the chat `chat` if set.
# A `command` is pasted at its prompt without running it.
name=$SWB_ARG_NAME cwd=${SWB_ARG_CWD:-$HOME} chat=$SWB_ARG_CHAT command=$SWB_ARG_COMMAND
[[ $name =~ '^[A-Za-z0-9_-]+$' ]] || { print -r -- '{"outcome": "failure", "summary": "invalid name"}'; exit 1 }
if ! tmux has-session -t "=$name" 2>/dev/null; then
  env -u RUN_ID -u SWB -u SOURCE_DIR -u SWB_ARG_NAME -u SWB_ARG_CWD -u SWB_ARG_CHAT -u SWB_ARG_COMMAND tmux new-session -d -s "$name" -c "$cwd" || exit 1
  [[ -n $command ]] && for _ in {1..30}; do
    [[ -n ${$(tmux capture-pane -p -t "=$name:")//[[:space:]]/} ]] && break
    sleep 0.1
  done
fi
[[ -n $chat ]] && tmux set-option -t "=$name:" @chat "$chat"
if [[ -n $command ]]; then
  tmux send-keys -t "=$name:" C-u
  print -rn -- "${command%$'\n'}" | tmux load-buffer -b swb-command - && tmux paste-buffer -p -d -b swb-command -t "=$name:"
fi
$SOURCE_DIR/commands/list | $SWB write term.sync
