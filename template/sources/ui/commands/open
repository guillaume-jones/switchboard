#!/bin/zsh
# ui.open {url}: opens a web or mailto link on this computer, for the desktop webview, which does not open links itself.
[[ $SWB_ARG_URL == (http://*|https://*|mailto:*) ]] || { print -r -- '{"outcome": "failure", "summary": "unsupported link"}'; exit 1 }
if [[ $OSTYPE == darwin* ]]; then exec open $SWB_ARG_URL; else exec xdg-open $SWB_ARG_URL; fi
